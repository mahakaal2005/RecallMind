{
  "info": {
    "name": "RecallMind",
    "_postman_id": "recallmind-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Vansh",
      "item": [
        {
          "name": "Upload valid .md file",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base}}/knowledge/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "server/scripts/sample-notes.md" }
              ]
            }
          }
        },
        {
          "name": "Upload invalid extension (error)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base}}/knowledge/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "server/package.json" }
              ]
            }
          }
        },
        {
          "name": "Quick capture",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/knowledge/quick",
            "body": {
              "mode": "raw",
              "raw": "{ \"lessonText\": \"Active recall beats re-reading for long-term memory\", \"source\": \"Huberman Lab Podcast\", \"category\": \"learning\" }"
            }
          }
        },
        {
          "name": "Quick capture missing field (error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/knowledge/quick",
            "body": {
              "mode": "raw",
              "raw": "{ \"source\": \"Test\" }"
            }
          }
        },
        {
          "name": "Activity log (last 20 lines)",
          "request": {
            "method": "GET",
            "url": "{{base}}/activity/log?lines=20"
          }
        },
        {
          "name": "Activity summary",
          "request": {
            "method": "GET",
            "url": "{{base}}/activity/summary"
          }
        },
        {
          "name": "System info",
          "request": {
            "method": "GET",
            "url": "{{base}}/system/info"
          }
        },
        {
          "name": "Create reflection",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/reflections",
            "body": {
              "mode": "raw",
              "raw": "{ \"text\": \"Applied the 2-minute rule today and it worked!\", \"mood\": \"proud\", \"linkedLessons\": [{ \"knowledgeEntryId\": \"REPLACE_WITH_ENTRY_ID\", \"lessonId\": \"REPLACE_WITH_LESSON_ID\" }] }"
            }
          }
        },
        {
          "name": "Create reflection bad mood (error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/reflections",
            "body": {
              "mode": "raw",
              "raw": "{ \"text\": \"Test\", \"mood\": \"happy\" }"
            }
          }
        },
        {
          "name": "List reflections (mood filter)",
          "request": {
            "method": "GET",
            "url": "{{base}}/reflections?mood=proud&page=1&limit=10"
          }
        },
        {
          "name": "Reflections by lesson",
          "request": {
            "method": "GET",
            "url": "{{base}}/reflections/by-lesson/REPLACE_WITH_LESSON_ID"
          }
        },
        {
          "name": "Delete reflection",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/reflections/REPLACE_WITH_REFLECTION_ID"
          }
        }
      ]
    },
    {
      "name": "Rajan",
      "item": [
        {
          "name": "Generate Quiz (standard)",
          "request": {
            "method": "GET",
            "url": "{{base}}/quiz/generate?count=5"
          }
        },
        {
          "name": "Generate Quiz with category",
          "request": {
            "method": "GET",
            "url": "{{base}}/quiz/generate?category=habits&count=3"
          }
        },
        {
          "name": "Submit Quiz",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/quiz/REPLACE_WITH_QUIZ_ID/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"REPLACE_WITH_QUESTION_ID\",\n      \"userAnswer\": \"I remembered the 2-minute rule\",\n      \"remembered\": true\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Submit Quiz already submitted (error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/quiz/REPLACE_WITH_QUIZ_ID/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"REPLACE_WITH_QUESTION_ID\",\n      \"userAnswer\": \"Attempt again\",\n      \"remembered\": true\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Quiz History",
          "request": {
            "method": "GET",
            "url": "{{base}}/quiz/history?page=1&limit=5"
          }
        },
        {
          "name": "Quiz Recall Stats",
          "request": {
            "method": "GET",
            "url": "{{base}}/quiz/stats"
          }
        },
        {
          "name": "Situational Retrieve (Help me with...)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/knowledge/retrieve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"problem\": \"I keep procrastinating and can't start my study session\",\n  \"limit\": 5\n}"
            }
          }
        },
        {
          "name": "Situational Retrieve missing problem (error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/knowledge/retrieve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 5\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base", "value": "http://localhost:5000/api" }
  ]
}
