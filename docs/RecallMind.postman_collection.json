    {
      "name": "Vansh",
      "item": [
        {
          "name": "Upload valid .md file",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base}}/knowledge/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "server/scripts/sample-notes.md"
                }
              ]
            }
          }
        },
        {
          "name": "Upload invalid extension (error)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base}}/knowledge/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "server/package.json"
                }
              ]
            }
          }
        },
