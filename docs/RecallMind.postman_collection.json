{
  "info": {
    "name": "RecallMind",
    "_postman_id": "recallmind-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Atul",
      "item": [
        {
          "name": "Create entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/knowledge",
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Atomic Habits\", \"source\": \"James Clear\", \"category\": \"habits\", \"sourceType\": \"book\", \"tags\": [\"focus\", \"routine\"], \"lessons\": [{ \"lessonText\": \"Make it obvious, easy, attractive, satisfying\", \"pageNumber\": 14 }] }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('entryId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create entry missing lessonText (error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/knowledge",
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Bad\", \"source\": \"Nobody\", \"category\": \"habits\", \"lessons\": [{ \"context\": \"no text\" }] }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
